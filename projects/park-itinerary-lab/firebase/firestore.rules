rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/plans/{planId} {
      function signedInAsOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      function validVersion(expectedRevision) {
        let fields = request.resource.data;
        return fields.keys().hasOnly(['revision', 'payload'])
          && fields.revision is int
          && fields.revision == expectedRevision
          && fields.payload is string
          && fields.payload.toUtf8().size() <= 800000;
      }

      allow get, list: if signedInAsOwner();
      allow create: if signedInAsOwner() && validVersion(1);
      allow update: if signedInAsOwner() && validVersion(resource.data.revision + 1);
      // 削除は空の payload と新しい revision で他の端末に伝える。
    }
  }
}
